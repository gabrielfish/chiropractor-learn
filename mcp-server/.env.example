# Secret key required in every request header: x-api-key: <value>
MCP_API_KEY="your-secret-mcp-api-key"

# Supabase (service role — server-side only)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# Algolia (search-only key is sufficient for read access)
ALGOLIA_APP_ID="your-algolia-app-id"
ALGOLIA_SEARCH_KEY="your-algolia-search-only-api-key"
ALGOLIA_INDEX_NAME="dcpg_content"

# Anthropic (for recommend tool)
ANTHROPIC_API_KEY="sk-ant-..."
