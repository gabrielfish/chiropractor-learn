# Secret key required in every admin request header: x-api-key: <value>
# Must be at least 48 characters. Generate with: openssl rand -base64 36
MCP_API_KEY="your-secret-mcp-api-key-minimum-48-characters-long"

# Supabase (service role — server-side only, never expose to client)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# Algolia (search-only key is sufficient for read access — do NOT use admin key here)
ALGOLIA_APP_ID="your-algolia-app-id"
ALGOLIA_SEARCH_KEY="your-algolia-search-only-api-key"
ALGOLIA_INDEX_NAME="dcpg_content"

# Anthropic (for recommend tool)
ANTHROPIC_API_KEY="sk-ant-..."

# Supadata (transcript fallback — tried before Whisper; get key at supadata.ai)
SUPADATA_API_KEY="your-supadata-api-key"

# OpenAI (for Whisper audio transcription fallback when YouTube captions unavailable)
OPENAI_API_KEY="sk-proj-..."

# Public URL of this MCP server (used in member token response)
MCP_PUBLIC_URL="https://mcp.dcpracticegrowth.com"
